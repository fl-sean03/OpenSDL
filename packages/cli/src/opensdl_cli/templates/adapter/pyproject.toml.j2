[project]
name = "opensdl-adapter-{{ name }}"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
  "opensdl-core>=0.1.0a0",
  "opensdl-capabilities>=0.1.0a0",
]

[project.entry-points."opensdl.adapters"]
{{ name }} = "opensdl_adapter_{{ module }}.adapter:{{ class_name }}"

[dependency-groups]
dev = ["pytest>=8", "pytest-asyncio>=0.24"]

[build-system]
requires = ["setuptools>=75"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
