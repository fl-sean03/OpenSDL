[project]
name = "opensdl-domain-{{ name }}"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = ["opensdl-core>=0.1.0a0"]

[project.entry-points."opensdl.domain_packs"]
{{ name }} = "opensdl_domain_{{ module }}.pack:get_pack"

[dependency-groups]
dev = ["pytest>=8"]

[build-system]
requires = ["setuptools>=75"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]
