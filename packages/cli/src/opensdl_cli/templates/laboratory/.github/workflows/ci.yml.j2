name: Laboratory configuration

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  agent-contract:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: astral-sh/setup-uv@08807647e7069bb48b6ef5acd8ec9567f424441b
        with:
          python-version: "3.12"
          enable-cache: true
      - run: uv run --no-project --with pyyaml python scripts/validate-skills.py

  full:
    if: vars.OPENSDL_PACKAGES_AVAILABLE == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: astral-sh/setup-uv@08807647e7069bb48b6ef5acd8ec9567f424441b
        with:
          python-version: "3.12"
          enable-cache: true
      - run: uv sync
      - run: ./scripts/check.sh
