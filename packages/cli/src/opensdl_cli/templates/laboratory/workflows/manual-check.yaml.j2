id: manual-check
name: Record a person-executed check
input_schema:
  type: object
  required: [completed_by]
  properties:
    completed_by: {type: string, minLength: 1}
  additionalProperties: false
steps:
  - id: attest
    capability: human.attest
    inputs:
      instruction: Confirm the reference work area is ready.
      completed_by: ${inputs.completed_by}
      outcome: completed
      notes: Recorded through the structured human-task capability.
      evidence: []
outputs:
  outcome: ${steps.attest.output.outcome}
  completed_by: ${steps.attest.output.completed_by}
