{
  "$defs": {
    "CandidateConstraint": {
      "additionalProperties": false,
      "description": "A linear feasibility requirement on the parameters, checked before anything is leased.\n\nLinear rather than an arbitrary predicate because a constraint has to survive being written\ndown: a callable cannot be stored in a campaign definition, sent over an interface, or read\nback out of the record. Sum-to-one, a budget, and an ordering are all linear. A requirement\nthat is not is expressed by the search space or refused by the optimizer.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Weights",
          "type": "object"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "tolerance": {
          "default": 1e-09,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "weights"
      ],
      "title": "CandidateConstraint",
      "type": "object"
    },
    "Objective": {
      "additionalProperties": false,
      "description": "One thing the campaign is searching for, and where a run reports it.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "minimize": {
          "default": true,
          "title": "Minimize",
          "type": "boolean"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "uncertainty_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Output"
        }
      },
      "required": [
        "name",
        "output"
      ],
      "title": "Objective",
      "type": "object"
    },
    "OutcomeConstraint": {
      "additionalProperties": false,
      "description": "A feasibility requirement on what a run produced, checked once it has produced it.\n\nAn observation that breaks one is still an observation: the work happened, the numbers are\nreal, and an optimizer doing constrained search needs them. It is excluded from the best and\ncannot reach a target, and nothing else about it changes.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "equals": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equals"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "output"
      ],
      "title": "OutcomeConstraint",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "description": "One dimension of the search space.\n\nA parameter states its own domain so the framework can check a candidate against it. Use the\nconstructors rather than the raw fields: they are the three combinations that are complete.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ParameterKind"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "choices": {
          "items": {},
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "ParameterKind": {
      "enum": [
        "continuous",
        "integer",
        "categorical"
      ],
      "title": "ParameterKind",
      "type": "string"
    },
    "SearchSpace": {
      "additionalProperties": false,
      "description": "The parameters a campaign is searching, declared by the campaign rather than the plugin.\n\nAn empty space validates nothing, which is how a campaign written against the two-method\noptimizer contract keeps running unchanged.",
      "properties": {
        "parameters": {
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "title": "Parameters",
          "type": "array"
        }
      },
      "title": "SearchSpace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What a campaign declared it is searching: the objectives, the space, and feasibility.\n\nThis is the framework's copy, not the plugin's. It is checked against every candidate before\nthe candidate becomes a run, and it is handed to an optimizer that asks for it, so the search\nspace is stated once.",
  "properties": {
    "objectives": {
      "items": {
        "$ref": "#/$defs/Objective"
      },
      "title": "Objectives",
      "type": "array"
    },
    "space": {
      "$ref": "#/$defs/SearchSpace"
    },
    "candidate_constraints": {
      "items": {
        "$ref": "#/$defs/CandidateConstraint"
      },
      "title": "Candidate Constraints",
      "type": "array"
    },
    "outcome_constraints": {
      "items": {
        "$ref": "#/$defs/OutcomeConstraint"
      },
      "title": "Outcome Constraints",
      "type": "array"
    }
  },
  "required": [
    "objectives"
  ],
  "title": "CampaignProblem",
  "type": "object"
}
